#!/bin/bash

# Slackware build script for google-endpoint-verification

# Copyright 2019-2026 Andrew Payne <phalange@komputermatrix.com>
# Copyright 2018-2019 Donald Cooley South Haven, Indiana USA
# Copyright 2026 José Maldonado <josemaldonado@bit2me.com>
# All rights reserved.
#
# Redistribution and use of this script, with or without modification, is
# permitted provided that the following conditions are met:
#
# 1. Redistributions of this script must retain the above copyright
#    notice, this list of conditions and the following disclaimer.
#
#  THIS SOFTWARE IS PROVIDED BY THE AUTHOR "AS IS" AND ANY EXPRESS OR IMPLIED
#  WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF
#  MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO
#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd "$(dirname "$0")" ; CWD=$(pwd)

PRGNAM=google-endpoint-verification
VERSION=${VERSION:-2025.12.15}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}

# Upstream (Google apt repo) naming. VERSION above is the build date of
# DEBVER: the epoch-ms stamp 1765828494702 is 2025-12-15 19:54 UTC.
DEBNAM=endpoint-verification
DEBVER=1765828494702-842239260
DEBFILE=${DEBNAM}_${DEBVER}_amd64.deb
DEBSHA256=2ea825143fd56a10d6ae3a3f2719cd47833479f7dd3faa6eed7f62ce2d0ac664

# Hash of Google's device_state.sh the sed edits below were written against.
STATE_SHA256=fc8b000a38308e63067af0f7caade932f4801a6a7f21209b0481b729d01ed398

INSTDIR=opt/google/$DEBNAM

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
    *) ARCH=$( uname -m ) ;;
  esac
fi

# could be useful to other scripts.
if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

# Abort build if architecture is not 64-bit.
if [ "$ARCH" != "x86_64" ]; then
  echo "$ARCH is not supported."
  exit 1
fi

set -e

if [ ! -f "$CWD/$DEBFILE" ]; then
  echo "$DEBFILE not found in $CWD, run ./download-deb.sh first." >&2
  exit 1
fi
echo "$DEBSHA256  $CWD/$DEBFILE" | sha256sum -c -

rm -rf "$PKG"
mkdir -p "$TMP" "$PKG" "$OUTPUT"
cd "$TMP"
rm -rf "$PRGNAM-$VERSION"
mkdir -p "$PRGNAM-$VERSION"

cd "$PRGNAM-$VERSION"
ar x "$CWD/$DEBFILE"
tar -xvf data.tar.* --no-same-owner
rm -f data.tar.* control.tar.* debian-binary

# Everything lives under /opt, like upstream. The init script, the systemd
# unit and the maintainer scripts do not apply to Slackware; see README for
# the rc.local snippet that replaces them.
find "$INSTDIR" ! -type l    -a \( \
  \(     -perm /111 -a ! -perm 755 -a -exec chmod -f 755 {} + \) -o \
  \(   ! -perm /111 -a ! -perm 644 -a -exec chmod -f 644 {} + \) \)

mkdir -p "$PKG/opt/google"
cp -a "$INSTDIR" "$PKG/opt/google/"
INST=$PKG/$INSTDIR
mkdir -p "$INST/var/lib" "$INST/share/native-messaging-hosts"

# Reference manifests only: system-wide ones are not read by a Flatpak
# browser, ev-flatpak-setup writes the per-user one.
cp -a etc/opt/chrome/native-messaging-hosts/*.json \
  "$INST/share/native-messaging-hosts/chrome-$DEBNAM.json"
cp -a usr/lib/mozilla/native-messaging-hosts/*.json \
  "$INST/share/native-messaging-hosts/firefox-$DEBNAM.json"

# Make device_state.sh aware of Slackware and of the Flatpak sandbox.
# - Flatpak bind-mounts the host os-release at /run/host/os-release.
# - The script runs with "set -u" and dies at the first printf of a value it
#   could not collect (no ufw.conf, unreadable serial), so default them.
STATE=$INST/bin/device_state.sh
echo "$STATE_SHA256  $STATE" | sha256sum -c -
chmod 755 "$STATE"
sed -i \
  -e '/^  OS_INFO_FILE=\/etc\/os-release$/a\  if [ -r /run/host/os-release ]; then\n    OS_INFO_FILE=/run/host/os-release\n  fi' \
  -e 's/\*ubuntu\*|\*debian\*)/*ubuntu*|*debian*|*slackware*)/' \
  -e '/^ACTION=\${1:-default}$/a\SERIAL_NUMBER=\nOS_VERSION=\nOS_FIREWALL=\nMODEL=\nMAC_ADDRESSES=' \
  "$STATE"
grep -q 'run/host/os-release' "$STATE"
grep -q '\*slackware\*' "$STATE"
grep -q '^OS_FIREWALL=$' "$STATE"
sh -n "$STATE"

# The script hardcodes absolute tool paths; warn about any missing here.
for tool in $(sed -n 's|^[A-Z]*=\(/[a-z/]*\)$|\1|p' "$STATE" | grep -v "^/$INSTDIR"); do
  [ -x "$tool" ] || echo "WARNING: $tool (used by device_state.sh) not found" >&2
done

install -m 0755 "$CWD/ev-flatpak-setup.sh" "$INST/bin/ev-flatpak-setup"

# apihelper is shipped as upstream built it, without stripping.

PKGDOC=$PKG/usr/doc/$PRGNAM-$VERSION
mkdir -p "$PKGDOC"
cat "$CWD/README" > "$PKGDOC/README"
cat "$CWD/$PRGNAM.SlackBuild" > "$PKGDOC/$PRGNAM.SlackBuild"

mkdir -p "$PKG/install"
cat "$CWD/slack-desc" > "$PKG/install/slack-desc"

chown -R root:root "$PKG"

cd "$PKG"
/sbin/makepkg -l y -c n "$OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
